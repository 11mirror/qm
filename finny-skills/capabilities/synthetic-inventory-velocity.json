{
  "schemaVersion": 1,
  "capabilityId": "synthetic_inventory_velocity",
  "revisionId": "synthetic_inventory_velocity.2026-10-30",
  "semanticCapability": "synthetic_inventory_velocity",
  "semanticAliases": ["inventory_velocity", "stock_efficiency"],
  "intent": {
    "dimensions": {
      "entity": { "type": "string" },
      "period": { "type": "date" },
      "currency": { "type": "enum", "values": ["source_base"] },
      "grain": { "type": "enum", "values": ["total"] },
      "sources": { "type": "string_list", "values": ["netsuite"] },
      "artifact": { "type": "enum", "values": ["optional", "required"] }
    }
  },
  "dimensions": {
    "required": ["entity", "period", "currency", "grain", "artifact"],
    "supported": {
      "currency": ["source_base"],
      "grain": ["total"],
      "sources": ["netsuite"],
      "accounting_book": ["primary"],
      "artifact": ["optional", "required"]
    },
    "defaults": { "sources": ["netsuite"] }
  },
  "operations": [
    {
      "id": "synthetic_inventory_source",
      "primitive": "suiteql_select",
      "dependsOn": [],
      "sql": "SELECT SUM(amount) AS inventory_value FROM synthetic_inventory WHERE entity = :entity_name AND posted_at <= :cutoff_date AND accounting_book = :accounting_book",
      "parameters": ["entity_name", "cutoff_date", "accounting_book"]
    },
    {
      "id": "synthetic_inventory_repeat",
      "primitive": "repeat_pull",
      "dependsOn": ["synthetic_inventory_source"],
      "operationId": "synthetic_inventory_source"
    },
    {
      "id": "synthetic_inventory_reconciliation",
      "primitive": "reconcile",
      "dependsOn": ["synthetic_inventory_source", "synthetic_inventory_repeat"],
      "leftField": "inventory_value",
      "rightField": "inventory_value",
      "tolerance": "0"
    }
  ],
  "resultOperationId": "synthetic_inventory_source",
  "parameterBindings": {
    "entity_name": { "source": "dimension", "path": ["entity"] },
    "cutoff_date": { "source": "dimension", "path": ["period"] },
    "accounting_book": { "source": "literal", "value": "primary" }
  },
  "artifactPolicy": {
    "allowedFormats": ["json", "csv"],
    "defaultFormat": "csv",
    "attachment": "when_requested"
  },
  "approvalPolicy": {
    "mode": "before_source",
    "binds": ["capability_revision", "dimensions", "operation_graph"]
  },
  "verificationPolicy": {
    "requiredOperationIds": ["synthetic_inventory_repeat", "synthetic_inventory_reconciliation"],
    "releaseGate": "delivery_eligible"
  }
}
